# 数据库 (无, MVP 纯文件)
# AI 模型提供商 (deepseek / minimax)
# Round-9 风格: 缺 env 时 LLM 客户端会 fail-fast
MODEL_PROVIDER=deepseek

# DeepSeek API key
# 格式: sk-<random hex>
# 申请: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# MiniMax API key
# 仅当 MODEL_PROVIDER=minimax 时必填
MINIMAX_API_KEY=

# 调试 (true/false)
DEBUG=false
